rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Grafiki naklejek i gotowe kompozycje arkuszy.
    // Gość musi móc wgrać plik zanim założy konto, więc zapis jest otwarty —
    // ogranicza go rozmiar, typ MIME i (docelowo) App Check.
    match /uploads/{allPaths=**} {
      // Adresy pobierania zawierają nieodgadywalny token, więc otwarty odczyt
      // nie oznacza, że da się przeglądać cudze pliki.
      allow read: if true;

      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }

    // Gotowy arkusz z kreatora i plik do druku gotowego zestawu: A4 w 300 dpi
    // (2480 × 3508 px) zapisane jako PNG bez strat. Arkusz wypełniony zdjęciami
    // waży kilkanaście megabajtów, więc limit 10 MB dla wgrywanych grafik
    // odrzucał takie zamówienia przy „Dodaj do koszyka”. Same piksele tego
    // formatu to niecałe 35 MB, stąd zapas do 40.
    //
    // Reguła dokłada uprawnienie do tej powyżej — dostęp jest, gdy pozwala
    // którakolwiek z pasujących.
    match /uploads/{dateFolder}/{fileName} {
      allow create: if fileName.matches('(composition|gotowy-zestaw-druk)-.*[.]png')
                    && request.resource.size < 40 * 1024 * 1024
                    && request.resource.contentType == 'image/png';
    }

    // Zapisany układ arkusza (pozycje naklejek, kontury cięcia), potrzebny do
    // ponownego otwarcia zamówienia w kreatorze.
    //
    // Kreator wgrywa go tutaj razem z obrazami arkusza — układ nie może iść
    // razem z treścią zamówienia, bo przekroczyłby limit rozmiaru żądania.
    // Zapis jest więc otwarty jak dla obrazów, ale odczyt już nie: pliki czyta
    // wyłącznie serwer przez Admin SDK, po sprawdzeniu właściciela zamówienia.
    match /layouts/carts/{fileName} {
      allow create: if request.resource.size < 4 * 1024 * 1024
                    && request.resource.contentType == 'application/json';
      allow read, update, delete: if false;
    }

    // Układy przypięte do zamówień — tylko serwer.
    match /layouts/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
